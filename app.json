{
  "expo": {
    "name": "Family Hub",
    "slug": "family-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "familyhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Family Hub needs photo access to share images with your family."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainer": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Family Hub needs microphone access to record voice messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
